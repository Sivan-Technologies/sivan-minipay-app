{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/mcp",
      "dest": "https://payment.sivantech.online/mcp"
    },
    {
      "src": "/api/v1/agent/invoke",
      "dest": "https://payment.sivantech.online/api/v1/agent/invoke"
    },
    {
      "src": "/api/v1/agent/capabilities",
      "dest": "https://payment.sivantech.online/api/v1/agent/capabilities"
    },
    {
      "src": "/api/v1/developer/transfers",
      "dest": "https://payment.sivantech.online/api/v1/developer/transfers"
    },
    {
      "src": "/api/v1/developer/capabilities",
      "dest": "https://payment.sivantech.online/api/v1/developer/capabilities"
    },
    {
      "src": "/api/v1/cashout/resolve-account",
      "dest": "https://payment.sivantech.online/api/v1/cashout/resolve-account"
    },
    {
      "src": "/api/v1/cashout/banks",
      "dest": "https://payment.sivantech.online/api/v1/cashout/banks"
    },
    {
      "src": "/api/v1/cashout/transfer-fee",
      "dest": "https://payment.sivantech.online/api/v1/cashout/transfer-fee"
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "https://payment.sivantech.online/api/v1/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://payment.sivantech.online/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
